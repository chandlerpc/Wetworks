# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
WETWORKS_DISCORD_WEBHOOK_URL=

# Optional: Grok for the Intel cell. Leave blank to use Claude web search.
XAI_API_KEY=

# Access code for the ops console on your phone. Make it long; generate one with:
#   openssl rand -hex 24
WETWORKS_CONSOLE_TOKEN=

# clAIr's Cloudflare Worker (private route). Leave blank to run clAIr locally.
WETWORKS_CLAIR_URL=
WETWORKS_CLAIR_TOKEN=

# C.L.a.i.R's voice (Azure neural TTS, free tier 500k characters/month).
# Create a free Speech resource in the Azure portal and copy its key and region (e.g. eastus).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
WETWORKS_VOICE_NAME=en-IE-EmilyNeural
# Hands-free mode: say the wake phrase to start, a stop phrase to end, or go quiet this long.
WETWORKS_WAKE_PHRASE=hey clair
WETWORKS_STOP_PHRASES=that's all clair|goodbye clair|that's all|goodbye
WETWORKS_VOICE_IDLE_SECONDS=90

# Set to true to test without spending money or posting to Discord
WETWORKS_DRY_RUN=false

WETWORKS_TIMEZONE=America/New_York
WETWORKS_MORNING_BRIEF=07:00
WETWORKS_EVENING_BRIEF=21:00
# Build phase: keep this small. Raise it once everything is proven.
WETWORKS_MONTHLY_BUDGET_USD=5

# local = free (Ollama + SearXNG on the MSI). claude / grok = paid, for testing only.
WETWORKS_PROVIDER=local
WETWORKS_LOCAL_MODEL=gemma4:12b
